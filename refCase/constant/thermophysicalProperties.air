FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;  // tabulated
    thermo          hConst; // hTabulated
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleInternalEnergy;
}
//pRef            1e5;
mixture
{
    specie
    {
        molWeight       28.9;
    }
    thermodynamics
    {
        Cp              1005;
        Hf              0;
    }
    transport
    {
        mu              18.2e-06;
        Pr              0.7;
    }
}

dpdt on;


// ************************************************************************* //
