FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType   RAS;
density         variable ; //uniform;
RAS
{
    RASModel           RNGkEpsilon;

    turbulence      on;

    printCoeffs     on;
}


